patients = {}
patient_id = 101


# Function to Add Patient
def add_patient():
    global patient_id

    print("\n----- ADD PATIENT -----")

    name = input("Enter Patient Name: ").strip()

    if not name:
        print("Invalid name. Name cannot be empty.")
        return

    try:
        age = int(input("Enter Patient Age: "))

        if age < 0 or age > 120:
            print("Invalid age. Enter a number between 0 and 120.")
            return

    except ValueError:
        print("Invalid age. Patient not added.")
        return

    disease = input("Enter Disease: ").strip()
    doctor = input("Enter Doctor Name: ").strip()

    if not disease or not doctor:
        print("Disease and Doctor name cannot be empty.")
        return

    pid = "P" + str(patient_id)

    patients[pid] = {
        "Name": name,
        "Age": age,
        "Disease": disease,
        "Doctor": doctor
    }

    print("Patient added. ID:", pid)

    patient_id += 1


# Function to View All Patients
def view_patients():

    print("\n----- ALL PATIENT RECORDS -----")

    if not patients:
        print("No patient records found.")
        return

    for pid, details in patients.items():

        print("\nPatient ID:", pid)
        print("Name:", details["Name"])
        print("Age:", details["Age"])
        print("Disease:", details["Disease"])
        print("Doctor:", details["Doctor"])


# Function to Search Patient
def search_patient():

    print("\n----- SEARCH PATIENT -----")

    pid = input("Enter Patient ID: ").strip().upper()

    if pid in patients:

        details = patients[pid]

        print("\nPatient Found!")
        print("Patient ID:", pid)
        print("Name:", details["Name"])
        print("Age:", details["Age"])
        print("Disease:", details["Disease"])
        print("Doctor:", details["Doctor"])

    else:
        print("Patient ID not found.")


# Function to Update Patient
def update_patient():

    print("\n----- UPDATE PATIENT -----")

    pid = input("Enter Patient ID: ").strip().upper()

    if pid not in patients:
        print("Patient ID not found.")
        return

    details = patients[pid]

    print("Enter new details.")
    print("Leave blank to keep the old value.")

    name = input("Enter New Name: ").strip()

    if name:
        details["Name"] = name

    age_input = input("Enter New Age: ").strip()

    if age_input:

        try:
            age = int(age_input)

            if 0 <= age <= 120:
                details["Age"] = age
            else:
                print("Invalid age. Old age kept.")

        except ValueError:
            print("Invalid age. Old age kept.")

    disease = input("Enter New Disease: ").strip()

    if disease:
        details["Disease"] = disease

    doctor = input("Enter New Doctor Name: ").strip()

    if doctor:
        details["Doctor"] = doctor

    print("Patient", pid, "updated successfully.")


# Function to Delete Patient
def delete_patient():

    print("\n----- DELETE PATIENT -----")

    pid = input("Enter Patient ID: ").strip().upper()

    if pid in patients:

        del patients[pid]

        print("Patient", pid, "deleted successfully.")
        print("Total patients:", len(patients))

    else:
        print("Patient ID not found.")


# Main Menu Function
def main():

    while True:

        print("\n================================")
        print("      HOSPITAL MANAGEMENT")
        print("================================")
        print("1. Add Patient")
        print("2. View All Patients")
        print("3. Search Patient")
        print("4. Update Patient")
        print("5. Delete Patient")
        print("6. Exit")
        print("================================")

        choice = input("Enter Your Choice: ").strip()

        if choice == "1":
            add_patient()

        elif choice == "2":
            view_patients()

        elif choice == "3":
            search_patient()

        elif choice == "4":
            update_patient()

        elif choice == "5":
            delete_patient()

        elif choice == "6":
            print("\nThank you for using Hospital Management System!")
            break

        else:
            print("Invalid choice. Please select 1 to 6.")


# Program Execution
if __name__ == "__main__":
    main()